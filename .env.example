# Copy to .env (gitignored) and fill in. Never commit real values.

# NCBI E-utilities: contact email is required by NCBI policy.
NCBI_EMAIL=you@example.com
# Optional: raises the rate limit from 3 to 10 requests/second.
NCBI_API_KEY=

# Crossref polite pool (Phase 1). Defaults to NCBI_EMAIL if empty.
CROSSREF_MAILTO=

# Optional hosted LLM (not required; local models are the default).
ANTHROPIC_API_KEY=

# Local database (docker compose). Any strong local password.
POSTGRES_PASSWORD=

# LLMs (Phase 2+). Comma-separated endpoints; LLM_MODEL overrides extract.active_model.
LLM_ENDPOINTS=http://localhost:11434
# OpenAI-compatible remote server, base URL without /v1 (e.g. a vLLM deployment).
LLM_REMOTE_ENDPOINTS=
LLM_MODEL=
