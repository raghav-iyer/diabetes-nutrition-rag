# Copy to .env (gitignored) and fill in. Never commit real values.

# NCBI E-utilities: contact email is required by NCBI policy.
NCBI_EMAIL=you@example.com
# Optional: raises the rate limit from 3 to 10 requests/second.
NCBI_API_KEY=

# Crossref polite pool (Phase 1). Defaults to NCBI_EMAIL if empty.
CROSSREF_MAILTO=

# Anthropic API (Phase 2+).
ANTHROPIC_API_KEY=
LLM_MODEL=
